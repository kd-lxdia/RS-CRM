# Backend Database
DATABASE_URL=postgres://username:password@host:5432/database?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (REQUIRED - Generate strong random values)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_SECRET

# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_WEBHOOK_VERIFICATION_KEY=your_sendgrid_webhook_verification_key

# Meta WhatsApp
META_WHATSAPP_TOKEN=your_meta_whatsapp_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_WHATSAPP_APP_SECRET=your_meta_app_secret_for_webhook_verification

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_S3_BUCKET_NAME=your_aws_s3_bucket_name_here
AWS_REGION=ap-south-1

# Backward compatibility keys (older services)
AWS_S3_BUCKET=your_aws_s3_bucket_name_here

# Frontend / General APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
ARKA360_API_KEY=your_arka360_api_key_here
ARKA360_BASE_URL=https://api.arka360.com/v1

# OpenRouter API (for AI Chatbot)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Frontend URL (for CORS and public links)
# For multiple origins, separate with commas: http://localhost:3000,https://yourdomain.com
# Default: Frontend runs on port 3000 (see frontend/vite.config.ts)
FRONTEND_URL=http://localhost:3000

# Bland AI (for AI Voice Agent)
BLAND_AI_API_KEY=your_bland_ai_api_key_here

# Backend URL (for webhooks)
BACKEND_URL=http://localhost:4000

# Internal API Key (for webhook authentication)
INTERNAL_API_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_KEY

# Environment
NODE_ENV=development
PORT=4000
